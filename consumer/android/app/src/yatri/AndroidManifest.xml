<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- getyatri.com -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getyatri.com" android:pathPrefix="/u"/>
                <data android:scheme="https" android:host="getyatri.com" android:pathPrefix="/link"/>
                <data android:scheme="https" android:host="getyatri.com" android:pathPrefix="/refer"/>
                <data android:scheme="http" android:host="getyatri.com" android:pathPrefix="/u"/>
                <data android:scheme="http" android:host="getyatri.com" android:pathPrefix="/link"/>
                <data android:scheme="http" android:host="getyatri.com" android:pathPrefix="/refer"/>
            </intent-filter>

            <!-- www.getyatri.com -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.getyatri.com" android:pathPrefix="/u"/>
                <data android:scheme="https" android:host="www.getyatri.com" android:pathPrefix="/link"/>
                <data android:scheme="https" android:host="www.getyatri.com" android:pathPrefix="/refer"/>
                <data android:scheme="http" android:host="www.getyatri.com" android:pathPrefix="/u"/>
                <data android:scheme="http" android:host="www.getyatri.com" android:pathPrefix="/link"/>
                <data android:scheme="http" android:host="www.getyatri.com" android:pathPrefix="/refer"/>
            </intent-filter>

        </activity>
    </application>
</manifest>
