linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Bridge' do

  common_pods

  target 'NammayatriTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # Un-Comment the below piece of code in case macOS is upgraded and buil is failing
     installer.pods_project.targets.each do |target|
           if target.name == 'BoringSSL-GRPC'
             target.source_build_phase.files.each do |file|
               if file.settings && file.settings['COMPILER_FLAGS']
                 flags = file.settings['COMPILER_FLAGS'].split
                 flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
                 file.settings['COMPILER_FLAGS'] = flags.join(' ')
               end
             end
           end
         end
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      # config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    fuse_path = "./Pods/HyperSDK/Fuse.rb"
    clean_assets = true # Pass true to re-download all the assets
    if File.exist?(fuse_path)
      if system("ruby", fuse_path.to_s, clean_assets.to_s)
      end
    end
    local_assets_path = "./local_assets.rb"
    local_assets = false
    if File.exist?(local_assets_path)
      if system("ruby", local_assets_path.to_s, local_assets.to_s)
      end
    end
  end
end

