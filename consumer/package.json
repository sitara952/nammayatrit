{
  "name": "Bridge",
  "version": "0.0.131",
  "private": true,
  "scripts": {
    "re:start": "concurrently --names \"ReScript,TypeScript,ConfigTypes\" --prefix \"[{name}]\" --prefix-colors \"bgBlue.bold,bgMagenta.bold,bgYellow.bold\" \"rescript build -w\" \"npx tsc --alwaysStrict --noEmit true --noUncheckedIndexedAccess --watch\" \"npx tsc -p ../libs/config-types --watch\"",
    "rs:start": "rescript build -w",
    "ts:start": "npx tsc --alwaysStrict --noEmit true --noUncheckedIndexedAccess --watch",
    "re:build": "rescript",
    "re:clean": "rescript clean && find src -type f -name \"*.gen.tsx\" -delete",
    "res:format": "rescript format -all",
    "ct:build": "npx tsc -p ../libs/config-types",
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "lint": "eslint src/typescript src-v2",
    "start": "react-native start",
    "test": "jest",
    "pod-install": "cd ios && bundle exec pod install",
    "postinstall": "patch-package && yarn re:clean && yarn re:build",
    "ios:variant": "npx react-native run-ios --scheme",
    "android:variant": "npx react-native run-android --mode",
    "run-ios": "bash -c 'variant=\"$0\" && fetchedName=$(echo $variant | cut -d\"-\" -f1) && bash resolveAssets.sh $fetchedName && npx react-native run-ios --scheme $variant'",
    "run-android": "bash -c 'variant=\"$0\" && appId=\"$1\" && fetchedName=$(echo $variant | sed -E \"s/(DevDebug|DevRelease|ProdDebug|ProdRelease)//\") && bash resolveAssets.sh $fetchedName && npx react-native run-android --mode $variant --appId $appId'",
    "lint-fix": "npx eslint '**/*.{ts,tsx}' --fix",
    "lint-changes": "git diff --name-only HEAD | grep -E '\\.(ts|tsx)$' | sed 's|^consumer/||' | xargs npx eslint",
    "lint-last": "git diff --name-only HEAD~1 | grep -E '\\.(ts|tsx)$' | sed 's|^consumer/||' | xargs npx eslint",
    "lint-recent": "git diff --name-only HEAD~1..HEAD | grep -E '\\.(ts|tsx)$' | sed 's|^consumer/||' | xargs npx eslint",
    "preinstall": "sh install.sh"
  },
  "pre-commit": [
    "res:format"
  ],
