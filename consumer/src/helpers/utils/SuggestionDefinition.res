open ConfigManager
open Utils

@genType
type value = {
  en_us: string,
  ta_in: string,
  kn_in: string,
  hi_in: string,
  ml_in: string,
  bn_in: string,
  te_in: string,
}
@genType
type suggestionDefinitions = {
  key: string,
  value: value,
}

let itemToObjectMapper = dict => {
  {
    en_us: getString(dict, "en_us", ""),
    ta_in: getString(dict, "ta_in", ""),
    kn_in: getString(dict, "kn_in", ""),
    hi_in: getString(dict, "hi_in", ""),
    ml_in: getString(dict, "ml_in", ""),
    bn_in: getString(dict, "bn_in", ""),
    te_in: getString(dict, "te_in", ""),
  }
}

let getSuggestionsDefinitionFromRC = () => {
  let data = try {
    Some(
      ConfigManager.getString("chat_suggestions_defs")
      ->JSON.parseExn
      ->Utils.getDictFromJson
      ->Dict.toArray
      ->Array.map(v => {
        let (key, value) = v
        let suggestionDefinitions: suggestionDefinitions = {
          key,
          value: value
          ->Utils.getDictFromJson
          ->itemToObjectMapper,
        }
        suggestionDefinitions
      }),
    )
  } catch {
  | _ => None
  }
  data
}

