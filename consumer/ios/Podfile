def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

def common_pods


  rn_maps_path = '../node_modules/react-native-maps'
  pod 'FirebaseFirestore'
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'ReactNativeBlur', :path => '../node_modules/@sbaiahmed1/react-native-blur', :modular_headers => true
  pod 'FLEX', :configurations => ['Debug']
  pod 'Firebase/Core'
  pod 'MobilityCustomer', :path => '../../nammayatri-ios/mobility-customer/'
  pod 'react-native-maps/Google', :path => rn_maps_path
  pod 'clevertap-react-native', :path => '../node_modules/clevertap-react-native', :modular_headers => true
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RN_NEW_ARCH_ENABLED = "1"
  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => true,
    :hermes_enabled => true,
    :fabric_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end



node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')


platform :ios, '15.1'
prepare_react_native_project!

# Uncomment the next line if
setup_permissions([
